<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="0IEiF^JYS;]_+F3VM6Pz" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="iHa3DB6DvT34ge`*K(i]"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace Onde {" line1="    /**" line2="     * Calcola la posizione y per l'animazione" line3="     */" line4="    //% block=&quot;Calcolo y con x $x e offset $offset&quot;" line5="    export function calcoloY(x: number, offset: number): number {" line6="        return Math.round(2 + Math.sin(offset + x * 1.2) * 2);" line7="    }" line8="}" numlines="9"></mutation></block></statement></block></xml>